#include"driver/gpio.h"
#include"driver/timer.h"
#include"esp_intr_alloc.h"
#define CPU_CLOCK 80  //80MHZ
#define TIMER_GROUP TIMER_GROUP_0
#define TIMER_INDEX TIMER_0
#define TIMER_DIV 20
#define expoalpha 0.001
#define sensor_pin GPIO_NUM_3
volatile uint64_t last_time =0;
volatile uint64_t time_diff=0;
float value=0;
void IRAM_ATTR pulseISR(void* arg){ //ISR
  uint64_t now_time =0;
  timer_get_counter_value(TIMER_GROUP,TIMER_INDEX,&now_time); 
  time_diff=now_time-last_time;
  last_time=now_time;
}
void init_timer(){
  timer_config_t config={//timer configurations
    .alarm_en =TIMER_ALARM_DIS,
    .counter_en=TIMER_START,
    .intr_type=TIMER_INTR_LEVEL,
    .counter_dir=TIMER_COUNT_UP,
    .auto_reload=TIMER_AUTORELOAD_DIS,
    .divider=TIMER_DIV,
  };
  timer_init(TIMER_GROUP,TIMER_INDEX,&config);
  timer_start(TIMER_GROUP,TIMER_INDEX);
  
}
void init_gpio_interrupt() {//interrupt settings
   
    gpio_set_direction(sensor_pin, GPIO_MODE_INPUT);
    gpio_set_intr_type(sensor_pin, GPIO_INTR_NEGEDGE);
    gpio_install_isr_service(ESP_INTR_FLAG_LEVEL1);
    gpio_isr_handler_add(sensor_pin, pulseISR, NULL);
}


void setup(){
  Serial.begin(115200);
 
  init_timer();
  //attachInterrupt(digitalPinToInterrupt(sensor_pin),pulseISR,FALLING);
  init_gpio_interrupt();
}
